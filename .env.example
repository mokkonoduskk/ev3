# Tiempo maximo de espera (segundos) por cada consulta a una API externa
REQUEST_TIMEOUT=5

# Si es True, ante una falla de red se usan datos locales de contingencia
ENABLE_OFFLINE_FALLBACK=True

# API de clima (Open-Meteo: no requiere llave)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
